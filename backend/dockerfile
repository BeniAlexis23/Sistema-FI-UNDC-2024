# Usa una imagen base de Node.js
FROM node:latest

# Establece el directorio de trabajo dentro del contenedor
WORKDIR /src

# Copia el package.json e instala las dependencias
COPY package*.json ./
RUN npm install

# Copia el código fuente del backend
COPY . .

# Expone el puerto en el que la aplicación corre
EXPOSE 3000

# Comando para ejecutar el servidor
CMD ["npm", "run", "start"]